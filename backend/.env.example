DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Opcional: host sem -pooler. O release do Fly já remove -pooler sozinho na migrate.
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Asaas — nunca commitar a API key. Sandbox e produção são contas SEPARADAS.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=

