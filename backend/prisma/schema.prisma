// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUÁRIOS E AUTENTICAÇÃO
// ============================================

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  phone              String?            // Telefone do cliente
  firebaseUid        String?            @unique // Firebase Auth (pode ser null para clientes criados pelo admin)
  profileImageUrl    String?
  role               Role               @default(CLIENT)
  stripeCustomerId   String?            @unique // legado Stripe (não usar)
  asaasCustomerId    String?            @unique // ID do cliente no Asaas
  
  // Relacionamentos
  anamnesisForm      AnamnesisForm?
  appointments       Appointment[]
  subscription       Subscription?
  vouchers           Voucher[]
  monthlyUsage       MonthlyUsage[]
  notifications      Notification[]
  packagePurchases   PackagePurchase[]
  
  // Controle
  isActive           Boolean            @default(true) // Admin pode desativar um cliente
  createdBy          String?            // ID do admin que criou (se aplicável)
  /** Quando o cliente já viu a tela de boas-vindas pós-anamnese (SubscriptionCheck). */
  clubWelcomeSeenAt  DateTime?
  /** Token Expo Push (ExponentPushToken[...]) do dispositivo atual. */
  expoPushToken      String?
  /** Master switch: recebe push no aparelho. */
  pushAllEnabled     Boolean            @default(true)
  /** Lembretes de agendamento via push. */
  appointmentRemindersEnabled Boolean   @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([email])
  @@index([role])
}

// ============================================
// SERVIÇOS E TRATAMENTOS
// ============================================

model Service {
  id           String            @id @default(cuid())
  name         String
  description  String            @db.Text
  category     ServiceCategory   @default(CORPORAL) // Facial, Corporal, Massagem - TEMPORÁRIO: depois ajustamos
  duration     Int               // Duração em minutos
  price        Float             // Preço avulso
  isActive     Boolean           @default(true)

  /** Máquina alugada (Laser/Crio). null = serviço normal. */
  machineKind           MachineKind?
  /** Se false, não entra em planos mesmo que gestora tente vincular. */
  allowOnSubscription   Boolean      @default(true)

  /** Pacote (category COMBO): quantas sessões o curso tem. null = serviço avulso. */
  packageSessionCount   Int?
  /** Marcação para checkout parcelado (Asaas/AbacatePay). Stripe v1 cobra à vista. */
  installmentsAllowed   Boolean      @default(false)
  
  // Relacionamentos
  plans        SubscriptionPlan[] @relation("ServicesOnPlans")
  appointments Appointment[]
  packageItems          PackageItem[]      @relation("PackageItems")
  includedInPackages    PackageItem[]      @relation("IncludedInPackages")
  packagePurchases      PackagePurchase[]
  
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([machineKind])
}

// ============================================
// PLANOS DE ASSINATURA
// ============================================

model SubscriptionPlan {
  id                      String              @id @default(cuid())
  name                    String              // "Essencial Beauty", "Plus Care", "Premium Experience"
  tier                    PlanTier            // BRONZE, SILVER, GOLD
  description             String              @db.Text
  price                   Float               // Valor mensal
  stripePriceId           String?             @unique // legado Stripe (não usar)
  
  // REGRAS DE LIMITE
  maxTreatmentsPerMonth   Int                 // 4 ou 6 tratamentos por mês
  maxTreatmentsPerWeek    Int                 // 1 para Bronze/Prata, 2+ para Ouro
  maxFacialPerMonth       Int?                // Limite de faciais por mês (ex: 1)
  
  // Relacionamentos
  services                Service[]           @relation("ServicesOnPlans")
  subscriptions           Subscription[]
  
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([tier])
  @@index([isActive])
}

model Subscription {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String
  plan                  SubscriptionPlan    @relation(fields: [planId], references: [id])
  
  stripeSubscriptionId  String?             @unique // legado Stripe
  asaasSubscriptionId   String?             @unique
  
  // Status e datas
  status                SubscriptionStatus  @default(ACTIVE)
  startDate             DateTime            @default(now())
  endDate               DateTime?           // Fim do acesso (ex.: cancel_at_period_end)
  minimumCommitmentEnd  DateTime?           // LEGADO — fidelidade removida; não usar
  
  // Controle
  canceledAt            DateTime?
  cancelReason          String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// CONTROLE DE USO MENSAL
// ============================================

// Rastreia quantos tratamentos o cliente usou em cada mês
model MonthlyUsage {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  month                 Int      // 1-12
  year                  Int      // 2024, 2025...
  
  // Contadores
  totalTreatments       Int      @default(0) // Total de tratamentos usados no mês
  facialTreatments      Int      @default(0) // Total de faciais usados (para limite)
  
  // Controle semanal (semanas do mês: 1, 2, 3, 4, 5)
  weeklyUsage           Json     // Ex: { "1": 1, "2": 0, "3": 1, "4": 1 } - tratamentos por semana
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

// ============================================
// AGENDAMENTOS
// ============================================

model Appointment {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  
  // Data e hora
  startTime       DateTime
  endTime         DateTime
  
  // Status e origem
  status          AppointmentStatus @default(PENDING)
  origin          AppointmentOrigin // De onde veio o agendamento
  
  // Pagamento (para tratamentos avulsos)
  paymentStatus   PaymentStatus?    // Null se for de assinatura/voucher
  paymentMethod   String?           // "pix", "credit_card", "debit_card"
  paymentAmount   Float?
  paymentExpiresAt DateTime?        // Hold de checkout online (expira em N min se não pagar)
  asaasPaymentId   String?          // Cobrança Asaas (estorno / cancelar QR)
  
  // Voucher (se aplicável)
  voucherId       String?
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  
  // Controle
  confirmedByAdmin Boolean          @default(false)
  canceledBy       String?          // "client" ou "admin"
  canceledAt       DateTime?
  cancelReason     String?
  hiddenFromHistory Boolean         @default(false) // Ocultar do histórico do cliente (soft delete)
  
  // Observações
  notes            String?          @db.Text
  adminNotes       String?          @db.Text // Observações privadas do admin

  /** Sessão de um pacote comprado (null = tratamento avulso/plano). */
  packagePurchaseId   String?
  packagePurchase     PackagePurchase? @relation(fields: [packagePurchaseId], references: [id], onDelete: SetNull)
  packageSessionIndex Int?
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
  @@index([paymentExpiresAt]) // Para encontrar agendamentos expirados
  @@index([packagePurchaseId])
  @@index([asaasPaymentId])
}

// ============================================
// PACOTES (categoria COMBO no catálogo)
// ============================================

model PackageItem {
  id                String   @id @default(cuid())
  packageServiceId  String
  packageService    Service  @relation("PackageItems", fields: [packageServiceId], references: [id], onDelete: Cascade)
  includedServiceId String
  includedService   Service  @relation("IncludedInPackages", fields: [includedServiceId], references: [id], onDelete: Restrict)
  sortOrder         Int      @default(0)
  durationMinutes   Int

  @@unique([packageServiceId, includedServiceId])
  @@index([packageServiceId])
}

model PackagePurchase {
  id                  String                 @id @default(cuid())
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageServiceId    String
  packageService      Service                @relation(fields: [packageServiceId], references: [id])

  sessionCount        Int
  sessionsScheduled   Int                    @default(0)
  pricePaid           Float
  paymentStatus       PaymentStatus          @default(PENDING)
  status              PackagePurchaseStatus  @default(PENDING)
  itemsSnapshot       Json
  installmentsAllowed Boolean                @default(false)
  paymentExpiresAt    DateTime?
  asaasPaymentId      String?

  appointments        Appointment[]

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([userId, status])
  @@index([packageServiceId])
  @@index([paymentExpiresAt])
  @@index([asaasPaymentId])
}

model ProcessedWebhookEvent {
  id        String   @id
  source    String   @default("asaas")
  event     String
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// ============================================
// VOUCHERS E PRESENTES
// ============================================

model Voucher {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            VoucherType   // FREE_TREATMENT, FREE_MONTH, DISCOUNT
  description     String        // "Presente de aniversário", "Cortesia"
  
  // Para tratamento gratuito
  serviceId       String?       // Se for tratamento específico
  anyService      Boolean       @default(false) // Cliente pode escolher qualquer tratamento
  
  // Para desconto
  discountPercent Float?        // 50 = 50% de desconto
  discountAmount  Float?        // R$ 50 de desconto
  
  // Para mês grátis de plano
  planId          String?       // Se for mês grátis de um plano específico
  
  // Status
  isUsed          Boolean       @default(false)
  usedAt          DateTime?
  expiresAt       DateTime?     // Data de expiração
  
  // Relacionamentos
  appointments    Appointment[]
  
  // Observações
  grantedBy       String        // ID do admin que concedeu
  grantedReason   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([isUsed])
}

// ============================================
// FICHA DE ANAMNESE
// ============================================

model AnamnesisForm {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dados pessoais (Step 1)
  personalData Json     // Nome completo, data nascimento, endereço, etc

  // Estilo de vida (Step 2)
  lifestyleData Json    // Alimentação, exercícios, sono, etc

  // Saúde (Step 3)
  healthData   Json     // Alergias, medicamentos, doenças, etc

  // Objetivos (Step 4)
  objectivesData Json   // O que espera dos tratamentos

  // Termo (Step 5)
  termsAccepted Boolean @default(false)
  termsAcceptedAt DateTime?

  // 1 = wizard web legado | 2 = fluxo mobile Yazio-style
  schemaVersion Int     @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ============================================
// HORÁRIOS DE FUNCIONAMENTO
// ============================================

model ManagerSchedule {
  id              String   @id @default(cuid())
  dayOfWeek       Int      // 0 (Domingo) a 6 (Sábado)
  isAvailable     Boolean  @default(true)
  availableSlots  Json     // Ex: [{ start: "09:00", end: "12:00" }, { start: "14:00", end: "18:00" }]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dayOfWeek])
}

// Exceções de horário (feriados, dias específicos)
model ScheduleOverride {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  isAvailable     Boolean  // False para feriados/folgas
  availableSlots  Json?    // Horários específicos deste dia (se disponível)
  reason          String?  // "Feriado", "Folga", "Hora extra"
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// ============================================
// DEPOIMENTOS / TESTEMUNHOS
// ============================================

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String   // Ex: "Assinante Plus Care"
  avatar      String   // Letra inicial para avatar
  text        String   @db.Text
  rating      Int      @default(5)
  photoUrl    String?  // URL da foto (opcional)
  isActive    Boolean  @default(true)
  order       Int      @default(0) // Ordem de exibição
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// BANNERS / PROMOÇÕES (slider home)
// ============================================

enum BannerLocation {
  LANDING
  CLIENT
}

model Banner {
  id          String         @id @default(cuid())
  title       String
  imageUrl    String         @db.Text // data URL ou URL pública (MVP)
  location    BannerLocation
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  /** Deep link / path relativo (ex. /servicos?machine=CRYO). */
  linkPath    String?
  machineKind MachineKind?
  rentalOccurrenceId String? @unique
  rentalOccurrence   MachineRentalOccurrence? @relation(fields: [rentalOccurrenceId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([location, isActive, sortOrder])
  @@index([machineKind])
}

// ============================================
// MÁQUINAS ALUGADAS (Laser / Crio)
// ============================================

enum MachineKind {
  LASER
  CRYO
}

enum MachineRentalStatus {
  HELD      // Data segurada no calendário (ainda sem agendamento liberado)
  RELEASED  // Banner ativo — clientes podem agendar
  CANCELED  // Gestora cancelou o mês
  DONE      // Dia já passou
}

enum MachineRentalDefaultRule {
  LAST_THURSDAY
  SECOND_SATURDAY
}

model MachineRentalSettings {
  id                         String                   @id @default(cuid())
  kind                       MachineKind              @unique
  defaultRule                MachineRentalDefaultRule
  exclusiveDay               Boolean                  @default(false)
  suggestedReleaseDaysBefore Int                      @default(14)
  lateCancelHours            Int                      @default(24)
  lateCancelFeePercent       Float                    @default(25)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

model MachineRentalOccurrence {
  id         String               @id @default(cuid())
  kind       MachineKind
  year       Int
  month      Int                  // 1-12
  date       DateTime             @db.Date
  status     MachineRentalStatus  @default(HELD)
  releasedAt DateTime?
  banner     Banner?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([kind, year, month])
  @@index([date])
  @@index([status])
  @@index([kind, status])
}

// ============================================
// CONFIGURAÇÕES DO SISTEMA
// ============================================

model SystemConfig {
  id                          String   @id @default(cuid())
  
  // Regras de agendamento
  minCancellationHours        Int      @default(4)  // Mínimo de horas para cancelamento sem perda
  minRescheduleHours          Int      @default(4)  // Mínimo de horas para reagendamento
  
  // Horários padrão
  defaultStartTime            String   @default("09:00")
  defaultEndTime              String   @default("18:00")
  slotDuration                Int      @default(30) // Granularidade da grade de horários em minutos (slots dinâmicos)
  maxSimultaneous             Int      @default(1)  // Capacidade: quantos atendimentos podem se sobrepor no mesmo intervalo
  
  // Regras de assinatura
  minimumCommitmentMonths     Int      @default(0)  // LEGADO — fidelidade removida; manter 0
  
  // Notificações
  enableEmailNotifications    Boolean  @default(true)
  enableSmsNotifications      Boolean  @default(false)
  
  // Manutenção
  maintenanceMode             Boolean  @default(false)
  maintenanceMessage          String?
  
  // Informações de Contato
  phone                       String?
  whatsapp                    String?
  email                       String?
  instagram                   String?
  
  // Endereço
  addressCep                  String?
  addressStreet               String?
  addressNumber               String?
  addressComplement           String?
  addressNeighborhood         String?
  addressCity                 String?
  addressState                String?
  
  // Política de Cancelamento
  cancellationPolicy          String?
  
  // Preços dos Planos (para controle centralizado)
  priceBronze                 Float?   @default(200.00)
  priceSilver                 Float?   @default(300.00)
  priceGold                   Float?   @default(450.00)
  
  updatedAt                   DateTime @updatedAt
  updatedBy                   String?  // ID do admin que atualizou
}

// ============================================
// ENUMS
// ============================================

enum Role {
  CLIENT
  MANAGER
}

enum ServiceCategory {
  COMBO
  FACIAL
  CORPORAL
  MASSAGEM
}

enum PlanTier {
  BRONZE   // Essencial Beauty
  SILVER   // Plus Care
  GOLD     // Premium Experience
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  PAUSED
}

enum AppointmentStatus {
  PENDING       // Aguardando confirmação do admin
  CONFIRMED     // Confirmado pelo admin
  COMPLETED     // Finalizado
  CANCELED      // Cancelado
  NO_SHOW       // Cliente não compareceu
}

enum AppointmentOrigin {
  SUBSCRIPTION  // Veio da assinatura
  SINGLE        // Tratamento avulso
  VOUCHER       // Voucher/presente
  ADMIN_CREATED // Criado pelo admin
  PACKAGE       // Sessão de pacote pré-pago
}

enum PackagePurchaseStatus {
  PENDING    // Checkout Stripe em andamento
  ACTIVE     // Pago, ainda há sessões a usar ou futuras
  COMPLETED  // Todas as sessões usadas
  CANCELED   // Hold expirado / compra abortada
  REFUNDED   // Estorno do pacote inteiro (gestora)
}

enum PaymentStatus {
  PENDING       // Aguardando pagamento
  PAID          // Pago
  FAILED        // Falhou
  REFUNDED      // Estornado
}

enum VoucherType {
  FREE_TREATMENT  // Tratamento gratuito
  FREE_MONTH      // Mês grátis de assinatura
  DISCOUNT        // Desconto em tratamento
}

// ============================================
// NOTIFICAÇÕES
// ============================================

model Notification {
  id              String            @id @default(cuid())
  
  // Destinatário
  userId          String?           // Null = notificação para admin
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Tipo e conteúdo
  type            NotificationType
  title           String
  message         String            @db.Text
  
  // Ícone e estilo
  icon            NotificationIcon  @default(BELL)
  priority        NotificationPriority @default(NORMAL)
  
  // Status
  read            Boolean           @default(false)
  readAt          DateTime?
  
  // Metadados adicionais (JSON para flexibilidade)
  metadata        Json?             // Ex: { appointmentId, serviceId, amount, etc }
  
  // Link de ação (opcional)
  actionUrl       String?           // Ex: "/cliente/agenda", "/admin/agendamentos"
  actionLabel     String?           // Ex: "Ver agendamento", "Confirmar"
  
  // Controle
  expiresAt       DateTime?         // Data de expiração (auto-deletar)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

// ============================================
// ENUMS DE NOTIFICAÇÃO
// ============================================

enum NotificationType {
  // Agendamentos
  APPOINTMENT_CONFIRMED       // Admin confirmou agendamento
  APPOINTMENT_CANCELED        // Agendamento cancelado
  APPOINTMENT_RESCHEDULED     // Agendamento reagendado
  APPOINTMENT_REMINDER        // Lembrete de agendamento próximo
  APPOINTMENT_COMPLETED       // Agendamento concluído
  
  // Pagamentos
  PAYMENT_SUCCEEDED           // Pagamento bem-sucedido
  PAYMENT_FAILED              // Pagamento falhou
  PAYMENT_REFUNDED            // Pagamento estornado
  SUBSCRIPTION_RENEWED        // Assinatura renovada
  SUBSCRIPTION_EXPIRING       // Assinatura expirando em breve
  
  // Clientes (Admin)
  NEW_CLIENT_REGISTERED       // Novo cliente cadastrado
  NEW_APPOINTMENT_REQUEST     // Novo pedido de agendamento
  CLIENT_CANCELED             // Cliente cancelou agendamento
  
  // Vouchers e Presentes
  VOUCHER_RECEIVED            // Cliente ganhou voucher
  VOUCHER_EXPIRING            // Voucher expirando em breve
  
  // Assinaturas
  SUBSCRIPTION_ACTIVATED      // Assinatura ativada
  SUBSCRIPTION_CANCELED       // Assinatura cancelada
  PLAN_LIMIT_REACHED          // Limite de tratamentos atingido
  
  // Sistema
  SYSTEM_MESSAGE              // Mensagem do sistema/admin
  PROMOTION                   // Promoção ou novidade
  WELCOME                     // Boas-vindas
}

enum NotificationIcon {
  BELL          // Notificação geral
  CALENDAR      // Agendamentos
  CARD          // Pagamentos
  SPARKLES      // Presentes/Vouchers
  ALERT         // Avisos
  CHECK         // Confirmações
  INFO          // Informações
  GIFT          // Presentes
  STAR          // Destaques
  USER          // Usuários/Clientes
}

enum NotificationPriority {
  LOW           // Baixa prioridade
  NORMAL        // Prioridade normal
  HIGH          // Alta prioridade
  URGENT        // Urgente
}
