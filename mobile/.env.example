# API do backend (dev local / emulador)
EXPO_PUBLIC_API_URL=http://localhost:3333

# Google Sign-In (Firebase / Google Cloud → APIs & Services → Credentials)
# Web Client ID — obrigatório (audience do id_token / Firebase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS Client ID — obrigatório no iOS (tipo "iOS", bundle br.com.charmebela.app)
# Sem este ID o Google retorna 400 invalid_request / OAuth policy
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android Client ID — obrigatório no Android (tipo "Android" + SHA-1)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
