{
  "expo": {
    "name": "Charme & Bela",
    "slug": "charme-bela-app",
    "scheme": [
      "charmebela",
      "com.charmebela.app",
      "com.googleusercontent.apps.690927382095-2ahqe7aasq4ee5s6qt3bfongld9fhprf"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf7f4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.charmebela.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.charmebela.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf7f4"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "./plugins/withWindowsCmakeObjectPathMax",
      [
        "expo-notifications",
        {
          "color": "#ec4899",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4b9dd07f-b0d0-4e0a-935c-4b3b73361ee1"
      }
    },
    "owner": "marcossantos-1"
  }
}
